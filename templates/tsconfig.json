{
  "compilerOptions": {
    "target": "es2025",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUncheckedSideEffectImports": true,
    "allowImportingTsExtensions": true
  },
  "include": ["**/*"]
}
